# 一个兼容 OpenAI 的 Chat Completions 模型路径。
# 下面是 DeepSeek 示例；换用其他兼容端点时只需修改 base/model/key。

CODEFORGE_API_BASE=https://api.deepseek.com
CODEFORGE_API_KEY=
CODEFORGE_MODEL=deepseek-flash

# auto：OpenAI / DeepSeek 使用服务端的自动提示词/上下文缓存。
# 其他端点则在可用时通过 cached-token 用量字段进行观测。
# 仅对明确支持 prompt_cache_key 的端点才使用 explicit。
CODEFORGE_PROMPT_CACHE_MODE=auto

# 默认情况下，shell 命令每次调用都在独立的 Docker 容器中失败关闭。
# 镜像必须已存在于本地；CodeForge 绝不会隐式拉取镜像。
CODEFORGE_SHELL_BACKEND=docker
CODEFORGE_DOCKER_IMAGE=python:3.13-slim
# read-only 是更安全的默认值；仅在 shell 命令确实需要
# 修改工作区时才选择 read-write。
CODEFORGE_SHELL_WORKSPACE_MODE=read-only
CODEFORGE_SHELL_CPUS=1.0
CODEFORGE_SHELL_MEMORY=512m
CODEFORGE_SHELL_PIDS_LIMIT=128
CODEFORGE_SHELL_OUTPUT_LIMIT=65536
CODEFORGE_DOCKER_AUTO_START=true
CODEFORGE_DOCKER_STARTUP_TIMEOUT=30
