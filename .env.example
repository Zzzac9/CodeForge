# One OpenAI-compatible Chat Completions model path.
# DeepSeek example; change only base/model/key for another compatible endpoint.

CODEFORGE_API_BASE=https://api.deepseek.com
CODEFORGE_API_KEY=
CODEFORGE_MODEL=deepseek-v4-pro

# auto: OpenAI / DeepSeek use service-side automatic prompt/context caching.
# Other endpoints are observed via cached-token usage fields when available.
# Use explicit only for endpoints that document prompt_cache_key support.
CODEFORGE_PROMPT_CACHE_MODE=auto
