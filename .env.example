# One OpenAI-compatible Chat Completions model path.
# DeepSeek example; change only base/model/key for another compatible endpoint.

CODEFORGE_API_BASE=https://api.deepseek.com
CODEFORGE_API_KEY=
CODEFORGE_MODEL=deepseek-v4-pro

# auto: OpenAI / DeepSeek use service-side automatic prompt/context caching.
# Other endpoints are observed via cached-token usage fields when available.
# Use explicit only for endpoints that document prompt_cache_key support.
CODEFORGE_PROMPT_CACHE_MODE=auto

# Shell commands fail closed through a per-call Docker container by default.
# The image must already exist locally; CodeForge never pulls it implicitly.
CODEFORGE_SHELL_BACKEND=docker
CODEFORGE_DOCKER_IMAGE=python:3.13-slim
# read-only is the safer default; opt into read-write only when shell commands
# genuinely need to modify the workspace.
CODEFORGE_SHELL_WORKSPACE_MODE=read-only
CODEFORGE_SHELL_CPUS=1.0
CODEFORGE_SHELL_MEMORY=512m
CODEFORGE_SHELL_PIDS_LIMIT=128
CODEFORGE_SHELL_OUTPUT_LIMIT=65536
CODEFORGE_DOCKER_AUTO_START=true
CODEFORGE_DOCKER_STARTUP_TIMEOUT=30
